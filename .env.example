# Django
SECRET_KEY=change_me_in_production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Development with SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For MySQL (Production), uncomment and set:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306

# AI Providers
# Metis (optional if you use AIAgent endpoints)
METIS_API_KEY=
METIS_BOT_ID=
# OpenAI (required for /api/openai/chat/)
OPENAI_API_KEY=

# Optional
DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=staticfiles_production
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL_DJANGO=INFO
DJANGO_LOG_LEVEL_DB=INFO
DJANGO_LOG_LEVEL_APP=DEBUG